<?xml version="1.0" encoding="UTF-8"?>
<!--
  launchd agent for the console (macOS). The Mac counterpart of the
  "BeTenshi Console" scheduled task on Windows.

  DO NOT COPY THIS FILE INTO ~/Library/LaunchAgents DIRECTLY — it is a
  template. __CONSOLE_DIR__ must be replaced with the absolute path to your
  checkout first, because launchd will not expand ~ and reads no environment
  variables.

  Install (substitutes the path, installs and starts both agents):
      ./scripts/install-agents.sh

  Or by hand, for one agent:
      sed "s|__CONSOLE_DIR__|$(pwd)|g" scripts/com.betenshi.console.plist.template \
        > ~/Library/LaunchAgents/com.betenshi.console.plist
      launchctl bootstrap gui/$UID ~/Library/LaunchAgents/com.betenshi.console.plist

  Restart after a rebuild:
      launchctl kickstart -k gui/$UID/com.betenshi.console

  Stop it for good:
      ./scripts/install-agents.sh --uninstall

  RunAtLoad + KeepAlive is the point: the console is meant to be there without
  anyone starting it, and to come back if it dies. ThrottleInterval is raised
  from the 10 s default because the failure this guards against — no .next
  build — is not one that retrying fixes quickly.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.betenshi.console</string>

  <key>ProgramArguments</key>
  <array>
    <string>__CONSOLE_DIR__/scripts/start-console.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__CONSOLE_DIR__</string>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>30</integer>

  <!-- The launcher redirects into var/console.log itself; these catch anything
       that fails before it gets that far, which is where the useful message is
       when the agent will not start at all. -->
  <key>StandardOutPath</key>
  <string>__CONSOLE_DIR__/var/launchd.log</string>
  <key>StandardErrorPath</key>
  <string>__CONSOLE_DIR__/var/launchd.log</string>
</dict>
</plist>
