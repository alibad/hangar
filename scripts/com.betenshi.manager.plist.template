<?xml version="1.0" encoding="UTF-8"?>
<!--
  launchd agent for the service manager (macOS). The Mac counterpart of the
  "BeTenshi Manager" scheduled task on Windows.

  DO NOT COPY THIS FILE INTO ~/Library/LaunchAgents DIRECTLY — it is a
  template. __CONSOLE_DIR__ must be replaced with the absolute path to your
  checkout first, because launchd will not expand ~ and reads no environment
  variables.

  Install (substitutes the path, installs and starts both agents):
      ./scripts/install-agents.sh

  Or by hand, for one agent:
      sed "s|__CONSOLE_DIR__|$(pwd)|g" scripts/com.betenshi.manager.plist.template \
        > ~/Library/LaunchAgents/com.betenshi.manager.plist
      launchctl bootstrap gui/$UID ~/Library/LaunchAgents/com.betenshi.manager.plist

  Restart after a rebuild:
      launchctl kickstart -k gui/$UID/com.betenshi.manager

  Stop it for good:
      ./scripts/install-agents.sh --uninstall

  RunAtLoad + KeepAlive is the point: without this on :8099 the console renders
  but reports an empty machine — no capacity, no ready counts, every workstream
  stuck on "On demand". It must be there before anyone looks, and must come back
  if it dies.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.betenshi.manager</string>

  <key>ProgramArguments</key>
  <array>
    <string>__CONSOLE_DIR__/scripts/start-manager.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__CONSOLE_DIR__</string>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>30</integer>

  <!-- The launcher redirects into var/console.log itself; these catch anything
       that fails before it gets that far, which is where the useful message is
       when the agent will not start at all. -->
  <key>StandardOutPath</key>
  <string>__CONSOLE_DIR__/var/launchd-manager.log</string>
  <key>StandardErrorPath</key>
  <string>__CONSOLE_DIR__/var/launchd-manager.log</string>
</dict>
</plist>
